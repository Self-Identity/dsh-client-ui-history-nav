{
  "name": "dsh-client-ui-history-nav",
  "version": "1.5.0",
  "description": "Browser-style Back / Forward / Refresh controls in the DSH window title bar, shared by Sessions and plugin panels, with a confirmation before refreshing a running Session; display text follows the DSH locale (English / Chinese). 给 DSH 客户端加浏览器式页面后退、前进与刷新（顶栏按钮，中英双语随全局设置）。",
  "license": "MIT",
  "author": "Self-Identity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Self-Identity/dsh-client-ui-history-nav.git"
  },
  "homepage": "https://github.com/Self-Identity/dsh-client-ui-history-nav#readme",
  "bugs": {
    "url": "https://github.com/Self-Identity/dsh-client-ui-history-nav/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "navigation",
    "history"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "tools",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/smoke.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
